# ============================================================================
# WMS 仓库忽略规则
# 原则：密钥与本地配置不进代码库（文档 6.3.6）；只提交 .env.example 模板
# ============================================================================

# —— 环境变量与密钥 ——
.env
**/.env
!**/.env.example

# —— Python ——
__pycache__/
*.py[cod]
*.egg-info/
.venv/

# —— 前端 npm ——
node_modules/
demo/frontend/dist/

# —— 运行期数据（演示 SQLite 库，删除后首次启动会自动重建并灌种子数据）——
demo/data/*.db
demo/backend/data/*.db

# —— 文档构建中间产物 ——
doc/_book.md
doc/_book.html
doc/build/

# —— 编辑器与系统 ——
.vscode/
.idea/
Thumbs.db
Desktop.ini
# —— 运行期日志与临时库（压测/调试产物，不进仓库）——
demo/logs/
demo/data/_*.db*
*.log
