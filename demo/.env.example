# ============================================================================
# WMS 环境变量模板（复制为 .env 后按环境修改；.env 含密钥，不进代码库）
#
# 优先级：系统环境变量 > 本文件（.env）。
# 线上部署：按文档 6.3.6 用系统环境变量 / compose env_file 注入，权限 600。
# ============================================================================

# 运行环境：development / production
# production 强制要求 WMS_SECRET_KEY（缺失或短于 32 字节将拒绝启动）
WMS_ENV=development

# 监听地址与端口
# 127.0.0.1 = 仅本机可访问（生产推荐，前面挂 Nginx 反代）；
# 0.0.0.0   = 对外监听，必须配合防火墙只放行必要端口（见 deploy/ 目录）
WMS_HOST=127.0.0.1
WMS_PORT=8000

# API 签名密钥（登录 token 的 HMAC 签名密钥，等效“API 密钥”）
# 生成方式（>=32 字节）：openssl rand -base64 48
# 要求：各环境独立、不进代码库、每年轮换；更换后旧 token 全部失效（预期行为）
WMS_SECRET_KEY=replace-with-a-random-secret-at-least-32-bytes

# 登录 token 有效期（小时）
WMS_TOKEN_EXPIRE_HOURS=8

# 允许跨域访问的前端来源，逗号分隔（如 https://wms.example.com）
# 仅本地开发可保持 * ；线上必须收敛为真实域名白名单
WMS_CORS_ORIGINS=*

# SQLite 数据库文件路径（相对 app.py 所在目录，或绝对路径）
WMS_DB_PATH=data/wms.db

# ----------------------------------------------------------------------------
# MySQL 部署预留（当前演示版使用 SQLite；接入 MySQL 时启用以下配置）
# 数据库口令只允许存在于 .env / 系统环境变量，禁止写入代码或镜像
# ----------------------------------------------------------------------------
#WMS_DB_HOST=127.0.0.1
#WMS_DB_PORT=3306
#WMS_DB_USER=wms_app
#WMS_DB_PASSWORD=
#WMS_DB_NAME=wms
